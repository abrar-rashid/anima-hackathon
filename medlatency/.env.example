# Team bearer key for read-only Anima access. Never pass this on the command line.
ANIMA_API_KEY=

# Simulator origin. Do not append credentials to this URL.
ANIMA_BASE_URL=https://sim.animahacks.com

# Optional model provider for live semantic extraction.
# Leave empty to run labelled heuristic or replay analysis.
MEDLATENCY_LLM_PROVIDER=
MEDLATENCY_LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Local service
MEDLATENCY_HOST=127.0.0.1
MEDLATENCY_PORT=8765
MEDLATENCY_DATABASE=var/medlatency.sqlite
